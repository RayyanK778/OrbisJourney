{
  "name": "orbisjourney",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Interactive world history globe, 2000 BCE to 2000 CE",
  "scripts": {
    "data:build": "npm run data:fetch && node --max-old-space-size=8192 pipeline/build.ts",
    "data:fetch": "node pipeline/fetch-sources.mjs",
    "data:spike": "node --max-old-space-size=8192 pipeline/build-spike-data.mjs",
    "spike:dev": "vite spike",
    "spike:build": "vite build spike",
    "spike:bench": "node spike/bench/run-bench.mjs",
    "test": "node --test \"shared/**/*.test.ts\" \"pipeline/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p pipeline/tsconfig.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "@types/topojson-client": "3.1.5",
    "fflate": "0.8.3",
    "mapshaper": "0.7.101",
    "playwright-core": "1.64.1",
    "polygon-clipping": "0.15.7",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
